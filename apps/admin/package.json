    "@vitejs/plugin-react": "latest",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "wrangler": "^4.124.0"
  }
