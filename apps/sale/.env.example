# Public Laravel API origin. Leave empty during local development to use Vite's /api proxy.
VITE_API_URL=https://api.yourdomain.com

# Enables fixture staff login only; always false in a real deployment.
VITE_DEMO_MODE=false

# Legacy /customer UI development only. Must still be genuinely signed by a test shop bot.
VITE_DEV_TELEGRAM_INIT_DATA=
