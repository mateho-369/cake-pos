# ── Frontends (build-time, inlined by Vite) ───────────────────────────────────
# Production MUST set this. Do not hardcode relative paths in source.
# Example: https://api.yourdomain.com/api
#
# Local / Arena preview: leave UNSET so the apps call `/api` on their own
# origin and the Vite dev server proxies to the mock API. The user's browser
# is not on localhost, so never bake 127.0.0.1 into the client bundle.
VITE_API_URL=

# Optional cross-links between the two frontends (not required).
VITE_SALE_ORIGIN=https://sale.yourdomain.com
VITE_ADMIN_ORIGIN=https://admin.yourdomain.com

# ── Mock API / future Laravel ─────────────────────────────────────────────────
# Comma-separated allowlist. Production should be exactly the two frontend
# origins. Dev reflects the request Origin so preview hosts work.
PORT=8080
NODE_ENV=development
CORS_ORIGINS=https://sale.yourdomain.com,https://admin.yourdomain.com

# ── Compose-level MinIO credentials (root .env, NOT backend/.env) ─────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
