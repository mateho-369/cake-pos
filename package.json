{
  "name": "cake-pos",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev": "npm run dev --workspace=@cake-pos/admin",
    "dev:admin": "npm run dev --workspace=@cake-pos/admin",
    "dev:sale": "npm run dev --workspace=@cake-pos/sale",
    "dev:shop": "npm run dev --workspace=@cake-pos/shop",
    "build": "npm run build:admin && npm run build:sale && npm run build:shop",
    "build:admin": "npm run build --workspace=@cake-pos/admin",
    "build:sale": "npm run build --workspace=@cake-pos/sale",
    "build:shop": "npm run build --workspace=@cake-pos/shop",
    "typecheck": "npm run typecheck --workspace=@cake-pos/admin && npm run typecheck --workspace=@cake-pos/sale && npm run typecheck --workspace=@cake-pos/shop",
    "deploy:admin": "npm run deploy --workspace=@cake-pos/admin",
    "deploy:sale": "npm run deploy --workspace=@cake-pos/sale",
    "deploy:shop": "npm run deploy --workspace=@cake-pos/shop",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,css,json}\" \"backend/**/*.php\" \"*.{json,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,css,json}\" \"backend/**/*.php\" \"*.{json,md}\"",
    "test:unit": "node e2e/unit/unit-tests.mjs",
    "test:locale": "node e2e/locale-audit.mjs",
    "test:jsdom": "node e2e/ui-audit/run-audit.mjs",
    "test:ui:quick-add": "node e2e/ui-audit/verify-quick-add-category.mjs && node e2e/ui-audit/verify-quick-add-empty-state.mjs",
    "test:ui:categories": "node e2e/ui-audit/verify-category-review.mjs",
    "test:ui": "npm run test:ui:quick-add && npm run test:ui:categories && node e2e/ui-audit/verify-accountability.mjs && node e2e/ui-audit/verify-pending-orders.mjs && npm run test:ui:shift-gate && npm run test:ui:order-notes && npm run test:ui:telegram && npm run test:ui:orders && npm run test:ui:reports && npm run test:exports",
    "test:ui:shift-gate": "node e2e/ui-audit/verify-shift-gate.mjs",
    "test:ui:order-notes": "node e2e/ui-audit/verify-shop-order-note.mjs",
    "test:ui:reports": "node e2e/ui-audit/verify-report-detail.mjs",
    "test:exports": "node e2e/exports-verify/verify.mjs",
    "test:ui:orders": "node e2e/ui-audit/verify-orders-page.mjs",
    "test:ui:telegram": "node e2e/ui-audit/verify-telegram-chrome.mjs"
  },
  "devDependencies": {
    "@prettier/plugin-php": "^0.25.0",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6"
  }
}
