# HTTP
PORT=8080
NODE_ENV=production

# Must be changed in any non-demo deployment.
JWT_SECRET=replace-this-with-a-long-random-secret

# Exact browser origins allowed by CORS. Do not use *.
ADMIN_ORIGIN=https://admin.yourdomain.com
SALE_ORIGIN=https://sale.yourdomain.com

# SQLite database path. Mount /data as a persistent Docker volume.
DATABASE_PATH=/data/cake-pos.sqlite

# Seed credentials used only when the database is first created.
SEED_ADMIN_EMAIL=owner@atelier.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_PIN=9999
SEED_CASHIER_EMAIL=sophea@atelier.local
SEED_CASHIER_PASSWORD=ChangeMe123!
SEED_CASHIER_PIN=1234
