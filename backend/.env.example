# Laravel
APP_NAME="Cake POS API"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
APP_TIMEZONE=Asia/Phnom_Penh
LOG_CHANNEL=stderr
LOG_LEVEL=info

# HTTP port exposed by docker-compose
PORT=8080

# Exact browser origins allowed by CORS (no wildcard)
ADMIN_ORIGIN=https://admin.yourdomain.com
SALE_ORIGIN=https://sale.yourdomain.com
SHOP_ORIGIN=https://shop.yourdomain.com

# MySQL (DB_HOST is the docker-compose service name)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cake_pos
DB_USERNAME=cake_pos
DB_PASSWORD=replace-with-a-strong-password
DB_ROOT_PASSWORD=replace-with-a-different-strong-password

# Cloudflare R2 object storage (S3-compatible). Laravel signs browser PUTs and
# verifies uploaded bytes through the same R2 S3 API endpoint.
AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=g-cake
# S3 API endpoint — https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# Same as AWS_ENDPOINT for R2 (used when signing browser PUT URLs).
AWS_PUBLIC_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# Public object base URL (R2 custom domain or r2.dev public bucket URL). No trailing slash.
AWS_URL=https://media.yourdomain.com
# R2 prefers virtual-hosted-style URLs.
AWS_USE_PATH_STYLE_ENDPOINT=false

# Keep low-overhead services local on a small VM
CACHE_STORE=file
SESSION_DRIVER=file
# Run `php artisan queue:work` in production so Telegram notifications/broadcasts never block POS transactions.
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Optional prefix added to newly issued Sanctum personal-access tokens.
SANCTUM_TOKEN_PREFIX=

# First-run seed credentials; change all values before seeding production
SEED_ADMIN_EMAIL=owner@atelier.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_PIN=9999
SEED_CASHIER_EMAIL=sophea@atelier.local
SEED_CASHIER_PASSWORD=ChangeMe123!
SEED_CASHIER_PIN=1234

# Telegram bots MUST be separate BotFather registrations.
# The private staff bot only opens apps/sale and needs no backend identity token.
SALE_TELEGRAM_BOT_USERNAME=your_private_staff_bot
STAFF_TELEGRAM_BOT_TOKEN=123456789:replace-with-staff-botfather-token
STAFF_NOTIFICATION_CHAT_ID=-1001234567890
SHOP_MINI_APP_URL=https://shop.yourdomain.com
# This token belongs only to the public customer bot that owns apps/shop.
SHOP_TELEGRAM_BOT_USERNAME=your_public_shop_bot
SHOP_TELEGRAM_BOT_TOKEN=123456789:replace-with-public-shop-botfather-token
TELEGRAM_ADMIN_CHAT_ID=-1001234567890
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
KHQR_IMAGE_URL=https://cdn.yourdomain.com/shop-khqr.png
