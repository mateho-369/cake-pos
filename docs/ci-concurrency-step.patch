+      - name: Concurrency + cross-frontend consistency (8 racing sales, MySQL row locks)
+        env:
+          API_URL: http://127.0.0.1:8080
+          TELEGRAM_WEBHOOK_SECRET: ci-webhook-secret
+        run: |
+          # Restart the dev server with several workers so the racing
+          # requests really overlap instead of being serialised.
+          pkill -f 'artisan serve' || true
+          (cd backend && PHP_CLI_SERVER_WORKERS=8 nohup php artisan serve --host=127.0.0.1 --port=8080 > /tmp/serve-mp.log 2>&1 &)
+          for i in $(seq 1 30); do curl -sf http://127.0.0.1:8080/healthz && break; sleep 1; done
+          bash backend/tests/e2e/concurrency-verify.sh
+
       - name: PHPUnit contract test suite
         working-directory: backend
